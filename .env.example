# ==========================================
# Amica Configuration (.env)
# ==========================================

# --- Core LLM Configuration (Google Gemini) ---
# Set your Google Gemini API Key here:
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# --- GitHub Integration ---
# Enables GitHub API access for repository ingestion and issue fetching:
GITHUB_TOKEN=your_github_token_here
# Optional custom GitHub API URL (defaults to public GitHub):
# GITHUB_API_URL=https://api.github.com
# Git committer identity (for potential future features):
# GIT_COMMITTER_NAME=amica-bot
# GIT_COMMITTER_EMAIL=bot@amica.dev

# --- MCP Server Configuration ---
# Port for Model Context Protocol server (AI tool integration):
MCP_SERVER_PORT=3001

# --- Server & Network ---
# BACKEND_HOST=127.0.0.1
# BACKEND_PORT=8000
# Comma-separated or JSON list of allowed origins:
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Workspace & Storage ---
# WORKSPACES_DIR=../workspaces
# DATABASE_PATH=../backend/amica.db

# --- CAPSULE System ---
# CAPSULE_CACHE_TTL=3600
# FEDERATED_CAPSULE_THRESHOLD=1000

# --- Frontend Client ---
# NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
